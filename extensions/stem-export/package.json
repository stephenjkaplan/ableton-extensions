{
  "name": "stem-export",
  "version": "0.2.1",
  "main": "dist/extension.js",
  "engines": {
    "node": ">=24.16.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts --production",
    "build:dev": "tsc --noEmit && tsx build.ts",
    "start": "npm run build:dev && npm run predev-dirs && ableton-extensions-cli run --storage-directory .dev/storage --temp-directory .dev/temp",
    "package": "npm run build && ableton-extensions-cli package",
    "test": "vitest run",
    "predev-dirs": "node -e \"for (const d of ['.dev/storage','.dev/temp']) require('node:fs').mkdirSync(d,{recursive:true})\""
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:./vendor/ableton-extensions-sdk-1.0.0-beta.1.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./vendor/ableton-extensions-cli-1.0.0-beta.1.tgz",
    "@types/node": "^24.1.0",
    "esbuild": "0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
